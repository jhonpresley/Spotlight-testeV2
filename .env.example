# Template for local secrets. This file IS committed; .env is not.
#
# Setup:
#   cp .env.example .env      (Mac/Linux)
#   copy .env.example .env    (Windows)
# then fill in the values below.

# ---------------------------------------------------------------------------
# Database - REQUIRED
# ---------------------------------------------------------------------------
# The app stores everything in MySQL, so it needs a reachable server before it
# will start. Install MySQL 8 (Community Server), then put your credentials
# here. You do NOT need to create the database by hand - the connection string
# says createDatabaseIfNotExist, and Liquibase builds the tables inside it on
# first run, seed data included.
#
# MYSQL_URL only needs setting if your server is somewhere other than
# localhost:3306 or you want a different schema name. Leave it out otherwise.

MYSQL_USERNAME=root
MYSQL_PASSWORD=

# MYSQL_URL=jdbc:mysql://localhost:3306/recognitiondb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# ---------------------------------------------------------------------------
# AI - optional
# ---------------------------------------------------------------------------
# The app runs fine without this. Leave GROQ_API_KEY empty and the built-in
# mock evaluator takes over: nominations still get scores, rationales and
# flags, so a fresh clone is testable immediately. Add a key only when you want
# the real model.
#
# Groq API key, from console.groq.com. Free tier, no card required.

GROQ_API_KEY=
