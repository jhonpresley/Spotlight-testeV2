# Build output
target/
*.class

# Leftover H2 database files from before the move to MySQL. Nothing writes
# here any more; the entry stays so an old working copy does not suddenly
# start offering 7MB of binary database to a commit.
data/

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# OS
.DS_Store

# --- Secrets ---
# application.properties is safe to commit: it reads the Groq key from the
# GROQ_API_KEY environment variable (groq.api.key=${GROQ_API_KEY:}) rather
# than holding one. Keep it that way - this repository is public, so a key
# pasted into a tracked file is public the moment it is pushed and remains
# in the history even after it is deleted.
#
# Keep local secrets in .env, which is read at startup by spring-dotenv.
# .env.example IS committed - it documents what goes in .env without carrying
# any actual values.
.env
*.env
!.env.example
application-local.properties

# --- Front end ---
# frontend/ holds the React source. Its build output lands in
# src/main/resources/static/ and IS committed, so the project still runs with
# Maven alone and nobody needs Node to check it out.
frontend/node_modules/
frontend/.vite/

# Playwright's own generated output - failure screenshots/traces and the
# HTML report, regenerated on every run.
frontend/test-results/
frontend/playwright-report/

# --- AI agent tooling state ---
# Local Claude Code / agent-harness config and runtime state. Not project
# code, and some of it (memory DBs, policy state) is machine-specific.
.claude/
.claude-flow/
.swarm/
ruvector.db
.mcp.json
