<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="002-create-nomination-ai-flags-table" author="team">
        <createTable tableName="nomination_ai_flags">
            <column name="nomination_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="flag" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="nomination_ai_flags"
                baseColumnNames="nomination_id"
                referencedTableName="nominations"
                referencedColumnNames="id"
                constraintName="fk_nomination_ai_flags_nomination"/>

        <rollback>
            <dropForeignKeyConstraint baseTableName="nomination_ai_flags"
                                       constraintName="fk_nomination_ai_flags_nomination"/>
            <dropTable tableName="nomination_ai_flags"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
