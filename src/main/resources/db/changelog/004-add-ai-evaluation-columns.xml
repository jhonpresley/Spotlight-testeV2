<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="004-add-ai-evaluation-columns" author="team">
        <addColumn tableName="nominations">
            <column name="ai_score" type="INT"/>
            <column name="ai_rationale" type="CLOB"/>
            <column name="ai_prompt_version" type="VARCHAR(50)"/>
            <column name="ai_evaluation_status" type="VARCHAR(30)"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="nominations" columnName="ai_score"/>
            <dropColumn tableName="nominations" columnName="ai_rationale"/>
            <dropColumn tableName="nominations" columnName="ai_prompt_version"/>
            <dropColumn tableName="nominations" columnName="ai_evaluation_status"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
